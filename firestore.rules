rules_version = '2';

// =========================================================
// Stay @Phukphol — กฎความปลอดภัย Firestore (เวอร์ชันมีชำระเงิน + สลิป)
// คัดลอกทั้งหมดไปวางใน Firebase Console > Firestore > Rules แล้วกด Publish
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['staybaanphukphol@gmail.com', 'dc99degrees@gmail.com'];
    }

    // ห้องที่ถูกจองต่อคืน (ไม่มีข้อมูลส่วนตัว) id = "2026-12-24_3"
    match /roomNights/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date', 'room', 'bookingId'])
        && request.resource.data.room is int
        && request.resource.data.room >= 1 && request.resource.data.room <= 5
        && request.resource.data.date is string
        && id == request.resource.data.date + '_' + string(request.resource.data.room);
      allow update, delete: if isAdmin();
    }

    // ข้อมูลการจอง (มีข้อมูลส่วนตัว — เฉพาะแอดมินอ่านได้)
    match /bookings/{id} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.payment == 'unpaid'
        && !('doorCode' in request.resource.data)
        && request.resource.data.code is string && request.resource.data.code.size() == 4
        && request.resource.data.guestKey is string
        && request.resource.data.name is string && request.resource.data.name.size() < 120
        && request.resource.data.phone is string && request.resource.data.phone.size() < 30
        && request.resource.data.email is string && request.resource.data.email.size() < 120
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.rooms is list && request.resource.data.rooms.size() >= 1
        && request.resource.data.total is number
        && request.resource.data.createdAt == request.time;
      // ลูกค้าแจ้งว่าแนบสลิปแล้วได้อย่างเดียว
      allow update: if isAdmin()
        || (resource.data.payment == 'unpaid'
            && request.resource.data.payment == 'slip'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payment', 'slipAt']));
      allow read, delete: if isAdmin();
    }

    // สิ่งที่ลูกค้าเห็นได้ด้วยรหัสการจอง + เบอร์ 4 ตัวท้าย  id = "K7QX-6282"
    match /guestView/{key} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.state == 'awaiting_payment'
        && request.resource.data.keys().hasOnly(['bookingId', 'code', 'state', 'total', 'checkIn', 'checkOut', 'nights', 'rooms', 'rateName', 'createdAt'])
        && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId));
      allow update: if isAdmin()
        || (resource.data.state == 'awaiting_payment'
            && request.resource.data.state == 'slip'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'slipAt']));
      allow delete: if isAdmin();
    }

    // สลิปการโอน (รูปย่อ) — ลูกค้าส่งได้ครั้งเดียว แอดมินเปิดดูได้
    match /slips/{bookingId} {
      allow create: if exists(/databases/$(database)/documents/bookings/$(bookingId))
        && request.resource.data.keys().hasOnly(['image', 'createdAt'])
        && request.resource.data.image is string
        && request.resource.data.image.size() < 900000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
